<Window x:Class="WallpaperClient.WallpaperNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Название обоев" Width="420" Height="235" MinHeight="235"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F4F6F8" FontFamily="Arial">
    <Border Margin="18" Background="White" CornerRadius="18" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Название для карточки" FontSize="17" FontWeight="Bold"/>
            <TextBox x:Name="TitleBox" Grid.Row="2" Padding="10,7"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Background="#14141414" Foreground="#111111"
                        Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Добавить" IsDefault="True" Click="Add_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

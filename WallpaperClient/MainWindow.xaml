<Window x:Class="WallpaperClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenPaper" Height="500" Width="720" MinWidth="460" MinHeight="390"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" Foreground="#111111" FontFamily="Arial" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#141414"/><Setter Property="Foreground" Value="#F8FAFB"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="root" Property="Opacity" Value="0.70"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#14141414"/><Setter Property="Foreground" Value="#111111"/></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#111111"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,12"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="#0F141414" CornerRadius="16"><ScrollViewer x:Name="PART_ContentHost" Margin="2"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111111"/><Setter Property="BorderBrush" Value="#D9DCE0"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#111111"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="StartupSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Background="#DDE0E4" CornerRadius="14" Padding="4"><Border x:Name="Thumb" Width="20" Height="20" Background="White" CornerRadius="10" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#111111"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AudioSlider" TargetType="Slider">
            <Setter Property="Height" Value="30"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="0,7"><Border Height="6" Background="#DDE0E4" CornerRadius="3"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="#111111"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#111111" BorderBrush="White" BorderThickness="2" CornerRadius="7"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="Transparent"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LibraryScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="#0A141414" CornerRadius="5" Margin="1,2"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUp" Visibility="Collapsed"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#141414" CornerRadius="5" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDown" Visibility="Collapsed"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Border x:Name="MainSurface" Background="White" BorderBrush="#0D1117" BorderThickness="0.7" CornerRadius="22" Padding="28">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HeaderAudioColumn" Width="214"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="AudioControl" Grid.Column="1" Background="#0F141414" CornerRadius="18" Padding="4,3" Margin="10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><Button x:Name="MuteButton" Padding="0" Click="Mute_Click"><Viewbox Width="15" Height="15" Stretch="Uniform"><Grid Width="24" Height="24"><Path x:Name="SoundOnIcon" Data="M2,7 L6,7 L11,3 L11,21 L6,17 L2,17 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Path x:Name="SoundWaveInnerIcon" Data="M14,8 C17,10 17,14 14,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/><Path x:Name="SoundWaveOuterIcon" Data="M17,5 C22,9 22,15 17,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/><Path x:Name="SoundMutedIcon" Data="M2,7 L6,7 L11,3 L11,21 L6,17 L2,17 Z M15,9 L21,15 M21,9 L15,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="Collapsed"/></Grid></Viewbox></Button><Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" Margin="6,0" Style="{StaticResource AudioSlider}" ValueChanged="VolumeChanged"/><TextBlock x:Name="VolumeValueText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center" FontSize="11" FontWeight="Bold"/></Grid></Border>
                    <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource SoftButton}" Padding="14,8" Click="Settings_Click"/>
                </Grid>

                <Grid x:Name="LibraryPanel" Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="FormatText" Foreground="#74787F" FontSize="14"/>
                    <TextBlock x:Name="LibraryTitleText" Grid.Row="2" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="EmptyLibraryText" Grid.Row="4" Foreground="#8A8D91" FontSize="13" TextWrapping="Wrap"/>
                    <ListBox x:Name="LibraryCards" Grid.Row="6" Background="Transparent" BorderThickness="0" SelectionChanged="LibraryCardsSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource LibraryScrollBar}"/></ListBox.Resources>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SelectionFrame" CornerRadius="18" BorderBrush="Transparent" BorderThickness="2"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#111111"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border Width="178" CornerRadius="16" Background="#FAFAFA" BorderBrush="#1A141414" BorderThickness="1" ToolTip="{Binding Path}"><Grid><Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#141414" ClipToBounds="True" MouseEnter="CardPreviewEnter" MouseLeave="CardPreviewLeave"><Grid ClipToBounds="True"><Grid.Clip><RectangleGeometry Rect="0,0,178,116" RadiusX="16" RadiusY="16"/></Grid.Clip><MediaElement x:Name="PreviewPlayer" Width="178" Height="116" Source="{Binding PreviewUri}" LoadedBehavior="Pause" UnloadedBehavior="Stop" IsMuted="True" Stretch="UniformToFill" MediaEnded="CardPreviewEnded"/><TextBlock Text="{Binding PreviewSymbol}" FontSize="22" Foreground="#EEFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><Grid Grid.Row="1" Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><Grid Grid.Row="1" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FileName}" Foreground="#7A7E84" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Extension}" Foreground="#111111" FontSize="10" FontWeight="Bold" Margin="5,0,0,0"/></Grid></Grid></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="AddLibraryButton" Grid.Row="8" Click="AddLibrary_Click"/>
                </Grid>

                <Grid x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="LanguageSettingText" FontSize="15" FontWeight="Bold"/>
                    <Border Grid.Row="2" Background="#14141414" CornerRadius="22" Padding="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="RuButton" Padding="12,8" Click="Russian_Click">Русский</Button><Button x:Name="EnButton" Grid.Column="1" Padding="12,8" Click="English_Click">English</Button></Grid></Border>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock x:Name="PerformanceLabelText" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/><ComboBox x:Name="PerformanceComboBox" Grid.Column="1" SelectionChanged="PerformanceChanged"><ComboBoxItem Tag="0">Экономия</ComboBoxItem><ComboBoxItem Tag="1">Баланс</ComboBoxItem><ComboBoxItem Tag="2">Качество</ComboBoxItem></ComboBox></Grid>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OtherAppsMuteLabelText" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/><CheckBox x:Name="OtherAppsMuteCheckBox" Grid.Column="1" Style="{StaticResource StartupSwitch}" Checked="OtherAppsMuteChanged" Unchecked="OtherAppsMuteChanged"/></Grid>
                    <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AutoStartLabelText" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/><CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" Style="{StaticResource StartupSwitch}" Checked="AutoStartChanged" Unchecked="AutoStartChanged"/></Grid>
                </Grid>

                <Border Grid.Row="3" Background="#0A141414" CornerRadius="14" Padding="14,10" VerticalAlignment="Bottom"><TextBlock x:Name="StatusText" Foreground="#4B4F55" FontSize="12" TextWrapping="Wrap"/></Border>
            </Grid>
        </Border>
    </Grid>
</Window>
